# ─────────────────────────────────────────────────────────────────────────────
# .env.example  –  copy this to .env and fill in real values for local dev
# NEVER commit .env to git!
# ─────────────────────────────────────────────────────────────────────────────

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_CONFIG=development
# For production set to: production

# ── Security (REQUIRED in production) ────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here

# ── Admin Account ─────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@deepfake.com
ADMIN_PASSWORD=YourStrongAdminPassword!

# ── Database ─────────────────────────────────────────────────────────────────
# Leave blank to use SQLite (local dev)
# For production (HuggingFace/Render/Railway) use a PostgreSQL URL:
# DATABASE_URL=postgresql://user:password@host/dbname
DATABASE_URL=

# ── Public App URL (for email links) ─────────────────────────────────────────
# Set this to your deployed URL so email links work correctly
# Example for HuggingFace: https://your-username-spacename.hf.space
APP_URL=http://localhost:5000

# ── File Cleanup ──────────────────────────────────────────────────────────────
# Number of days before uploaded files are auto-deleted
UPLOAD_RETENTION_DAYS=7

# ── Email (optional — password reset emails) ──────────────────────────────────
# If left empty, email features are silently disabled (app still works)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@deepfake.com
